rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Entity Validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'userTagId', 'playerType', 'avatarUrl', 'status', 'isGoogleLinked', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['player', 'dm', 'moderator'] &&
             (!('status' in data) || data.status in ['pending', 'approved', 'rejected']) &&
             (!('isGoogleLinked' in data) || data.isGoogleLinked is bool);
    }

    function isValidCharacter(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'level']) &&
             data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.level is int && data.level >= 1 && data.level <= 20;
    }

    function isValidCampaign(data) {
      return data.keys().hasAll(['id', 'dmUserId', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.dmUserId is string && data.dmUserId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150;
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['id', 'authorId', 'title', 'content']) &&
             data.id is string && data.id.size() <= 128 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 10000;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                      isValidId(userId) &&
                      request.auth.uid == userId &&
                      isValidUserProfile(incoming()) &&
                      incoming().id == request.auth.uid;
      allow update: if isSignedIn() &&
                      isValidId(userId) &&
                      request.auth.uid == userId &&
                      isValidUserProfile(incoming()) &&
                      incoming().id == existing().id;
      allow delete: if false;
    }

    // Characters Collection
    match /characters/{characterId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
                      isValidId(characterId) &&
                      isValidCharacter(incoming()) &&
                      incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
                      isValidId(characterId) &&
                      isValidCharacter(incoming()) &&
                      resource.data.ownerId == request.auth.uid &&
                      incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() &&
                      isValidId(characterId) &&
                      resource.data.ownerId == request.auth.uid;
    }

    // Campaigns Collection
    match /campaigns/{campaignId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.dmUserId == request.auth.uid;
      allow create: if isSignedIn() &&
                      isValidId(campaignId) &&
                      isValidCampaign(incoming()) &&
                      incoming().dmUserId == request.auth.uid;
      allow update: if isSignedIn() &&
                      isValidId(campaignId) &&
                      isValidCampaign(incoming()) &&
                      resource.data.dmUserId == request.auth.uid &&
                      incoming().dmUserId == existing().dmUserId;
      allow delete: if isSignedIn() &&
                      isValidId(campaignId) &&
                      resource.data.dmUserId == request.auth.uid;
    }

    // Forum Posts Collection
    match /forumPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                      isValidId(postId) &&
                      isValidForumPost(incoming()) &&
                      incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() &&
                      isValidId(postId) &&
                      isValidForumPost(incoming());
      allow delete: if isSignedIn() &&
                      isValidId(postId);
    }

    // Forum Comments Collection
    match /forumComments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                      isValidId(commentId) &&
                      incoming().authorId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
                              isValidId(commentId);
    }

    // Friend Direct Messages Collection
    match /friendMessages/{messageId} {
      allow read: if isSignedIn() &&
                    (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() &&
                      isValidId(messageId) &&
                      incoming().fromUserId == request.auth.uid;
      allow update: if isSignedIn() &&
                      isValidId(messageId) &&
                      resource.data.toUserId == request.auth.uid;
      allow delete: if isSignedIn() &&
                      isValidId(messageId) &&
                      resource.data.fromUserId == request.auth.uid;
    }

    // Custom Visual Skins Collection
    match /skins/{skinId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(skinId);
      allow delete: if isSignedIn() && isValidId(skinId);
    }

    // Master Unified App Data Snapshot
    match /masterData/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(docId);
    }

    // Connectivity Test Document
    match /test/{testId} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
